# Copy this file to .env and fill in the real values:  cp .env.example .env
# Never commit .env — it is listed in .gitignore.

# OpenRouter API key (OpenAI-compatible endpoint). Budget is capped — see README "Spend".
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used by the normaliser / classifier (any OpenRouter model ID)
LLM_MODEL=anthropic/claude-haiku-4.5

# Sampling temperature — keep at 0 for reproducibility
LLM_TEMPERATURE=0

# Classifier confidence below this raises an EXC-03 review signal instead of an exception
CONFIDENCE_THRESHOLD=0.6
